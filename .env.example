# Copy to .env (ignored by git). Never commit real values.
# Web Push (VAPID): run `python scripts/gen_vapid.py` to fill all three (empty values count as missing).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Database (default sqlite:///data/floodready.db, created on startup)
DATABASE_URL=sqlite:///data/floodready.db
# Where resident photos are stored (default data/uploads)
UPLOADS_DIR=data/uploads

# Admin app: create accounts with scripts/seed_admin.py (bcrypt hash in the database). Set a long random JWT_SECRET.
JWT_SECRET=
# Optional separate key for signed photo links (>= 32 bytes; default: JWT_SECRET)
UPLOAD_URL_SECRET=
# Local development only: enables the published dev admin login and /docs. NEVER set on a reachable host.
# FLOODREADY_DEV_LOGIN=1
# Read-only Admin preview without an account ("Try a read-only preview" on the login page). Viewer rights, no residents'
# answers; needs JWT_SECRET. Unset it to turn the preview off and invalidate every preview token.
# ADMIN_PREVIEW=1
# Optional labelled events for statistics and reports (default data/events/events.csv)
EVENTS_CSV=
